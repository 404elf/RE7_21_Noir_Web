# Copy to the repository root as .env; this file does not deploy anything.
NOIR_BASE_PATH=/re7
NOIR_BIND=127.0.0.1
NOIR_PORT=8000

# Local HTTP testing: leave this empty.
# Behind an HTTPS proxy: set https://game.404elf.dev (no /re7 suffix).
# When the main domain changes, update this value; no image rebuild is needed.
NOIR_ORIGIN=

# Only for compose.proxy.example.yaml: explicitly list the proxy source IPs
# as seen by the container (the actual Docker gateway/proxy network may differ).
# Never set this to *. Leave unset until the deployment network is known.
# NOIR_TRUSTED_PROXIES=actual-proxy-source-IP-or-CIDR
